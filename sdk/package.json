{
	"name": "@jolli.ai/semantic-cache",
	"version": "0.1.0",
	"description": "分层语义缓存：把「问题像不像」和「旧答案还成不成立」分成各管一类失效的闸，并强制每个模型角色先过判别力自检",
	"type": "module",
	"main": "./src/index.ts",
	"exports": { ".": "./src/index.ts" },
	"files": ["src"],
	"license": "UNLICENSED",
	"private": true,
	"scripts": {
		"test": "node --test --experimental-strip-types test/*.test.ts",
		"typecheck": "tsc -p tsconfig.json",
		"smoke": "node --experimental-strip-types example/Smoke.ts",
		"all": "npm run typecheck && npm run test && npm run smoke"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"typescript": "^7.0.2"
	}
}
