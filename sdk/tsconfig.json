{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noEmit": true,
		"skipLibCheck": true,
		"lib": [
			"ES2022"
		],
		"types": [],
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.ts"
	]
}