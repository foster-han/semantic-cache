{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noEmit": true,
		"skipLibCheck": true,
		"lib": [
			"ES2022"
		],
		// 测试用 node:test / node:assert，冒烟示例用 console —— 所以这里要 node 类型。
		// 库代码本身仍然零依赖：src/ 下没有任何 node:* 导入，`npm run test` 之外不需要装东西。
		"types": [
			"node"
		],
		"allowImportingTsExtensions": true
	},
	// 测试与示例一并纳入。先前只有 src/**，于是 example/Smoke.ts 从来没被类型检查过 ——
	// 而它正是那种「契约变了没跟上」最容易漏掉的地方（验证台就为此吃过一次静默降级）。
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"example/**/*.ts"
	]
}
