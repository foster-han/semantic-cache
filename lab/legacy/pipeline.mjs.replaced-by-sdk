/**
 * 六道闸的读路径。
 *
 * 刻意做成每道闸都能单独关掉，并且 ⑤ ⑥ 的分数**无论开关都会算出来**——
 * 这样在 UI 上能直接看到「这一条如果把 ⑥ 关掉就会被放过」，不用重跑一遍。
 *
 * 存储是内存里的数组。这里验证的是判定逻辑，不是 pgvector 的查询计划；
 * 想验证后者得打真库，那是另一件事。
 */

import { cosine } from "./models.mjs";
import { COURSE, DISTRACTORS, DOCS, ENTITIES, SCENARIOS, STUDENT_RECORDS, SYL_V2 } from "./corpus.mjs";

export const DEFAULTS = {
	gate1: false, // ① Presidio 门控（检出实体 → 强制 user scope）
	gate4: true, // ④ cross-encoder 重排
	gate5: true, // ⑤ 语料版本比对
	gate6: true, // ⑥ 回答侧校验
	preAnonRetrieval: true, // ⑥ 的检索用保留实体的原文（文章说的硬前提）
	scopeMode: "course", // course（全班共享一个缓存）| unit（再按学生当前章节切）
	unitBoost: 0.92, // 检索时非当前章节的片段打的折扣
	thetaQ: 0.55, // ④ 重排分闸值（无重排器时退化为余弦闸值）
	recallFloor: 0.45, // ③ 召回下限
	thetaAHi: 0.97, // ⑥ 直接复用 —— 由 calib.mjs 在 e5 向量空间上标定
	thetaALo: 0.96, // ⑥ 微调复用
	topK: 5, // ③ 召回条数 —— 父文写的是 1，改成 5 才有 ④ 的插入点
	chunkK: 3, // ⑥ 检索取几个片段
	chunkCut: 0.85, // ⑥ 片段相对截断：低于最高分 × 该比例的片段不参与判定
};

/** 方案 A 的匿名化：按出现顺序编号，两个不同的人都会变成 <PERSON_1>。 */
export function anonymize(text) {
	let out = text;
	let n = 0;
	const found = [];
	for (const e of ENTITIES) {
		if (out.includes(e)) {
			n += 1;
			found.push({ token: `<PERSON_${n}>`, value: e });
			out = out.split(e).join(`<PERSON_${n}>`);
		}
	}
	return { text: out, found };
}

function normalize(text) {
	return text.trim().toLowerCase().replace(/\s+/g, "").replace(/[?？。.!！]$/u, "");
}

export function createLab(encoder) {
	let docs = DOCS.map(d => ({ ...d }));
	let cache = [];
	let seq = 0;
	let counters = fresh();
	let lastSources = []; // 最近一次 generate 用到的资料，供 bench 判据使用

	function fresh() {
		return { ask: 0, exact: 0, reuse: 0, tune: 0, regen: 0, evict: 0 };
	}

	/**
	 * 语料指纹只覆盖**这条缓存实际引用过的**文档，不是整门课。
	 *
	 * 一开始按课程算，结果「课程语境」场景在 ⑤ 就退出了——跨课探测时两门课的
	 * 指纹天然不同，⑤ 拦对了但拦的理由是错的，⑥ 反而没被测到。按 sourceIds
	 * 算才是文章第 ⑤ 层真正的语义：我引的那几篇变了没有。
	 */
	function fingerprint(sourceIds) {
		return sourceIds
			.map(id => {
				const d = docs.find(x => x.id === id);
				return d ? `${d.id}v${d.version}` : `${id}v?`;
			})
			.join(",");
	}

	/**
	 * 只有一门课，所以 scope 的粒度问题变成了「全班共享一个缓存」还是
	 * 「再按学生当前学到的章节切开」。① 门控命中时无条件降到 user。
	 */
	function scopeKey(cfg, req) {
		if (cfg.gate1 && req.piiFound) return `user:${req.user}`;
		if (cfg.scopeMode === "unit") return `course:${COURSE}|unit:${req.unit ?? "-"}`;
		return `course:${COURSE}`;
	}

	/**
	 * 课程内检索。**相对截断很重要**：一门课只有两篇文档时，无截断的 top-k 会把
	 * 两篇全捞回来，⑥ 于是永远能在里面找到支撑自己的那一篇 —— 塌陷就拦不住了。
	 * 只保留最高分 × chunkCut 以上的片段。
	 */
	/**
	 * 检索。两处偏离最朴素实现，都是为了贴近真实产品：
	 *
	 * 1. **章节加权**：学生当前学到第几章是产品知道的上下文，非当前章节的片段打个
	 *    折扣。没有这个上下文的话，「归一化是怎么做的」在两个学生那里是完全相同的
	 *    输入，缓存复用其实是对的 —— 那时它就不是缓存问题，是检索歧义。
	 * 2. **个人数据源**：问题里提到某个学生时，把那个学生的成绩记录也当作一个片段。
	 *    它检索不到、只能靠实体名字命中 —— 这正是匿名化会毁掉的那条路。
	 */
	async function retrieve(text, cfg = DEFAULTS, unit = null) {
		const pool = docs.filter(d => d.course === COURSE).map(d => ({ ...d }));

		// 个人数据源：只有文本里真的出现了学生名字才够得到
		for (const [name, rec] of Object.entries(STUDENT_RECORDS)) {
			if (text.includes(name)) pool.push({ id: `rec:${name}`, course: COURSE, unit: "个人数据", title: `${name} 的成绩记录`, version: 1, text: rec });
		}
		if (pool.length === 0) return [];

		// 检索是问题↔段落，必须用检索模型，不能用 ③ 那个句对模型
		const [qv] = await encoder.embedQuery([text]);
		const dv = await encoder.embedPassage(pool.map(d => d.text));
		const boost = cfg.unitBoost ?? DEFAULTS.unitBoost;
		const ranked = pool
			.map((d, i) => ({
				doc: d,
				vec: dv[i],
				score: cosine(qv, dv[i]) * (unit && d.unit !== unit && d.unit !== "个人数据" ? boost : 1),
			}))
			.sort((a, b) => b.score - a.score)
			.slice(0, cfg.chunkK ?? DEFAULTS.chunkK);
		const cut = ranked[0].score * (cfg.chunkCut ?? DEFAULTS.chunkCut);
		return ranked.filter(r => r.score >= cut);
	}

	/**
	 * 拼答案。
	 *
	 * 注意这是个**已知的方法学缺陷**：真实答案是 LLM 改写、压缩、综合过的，
	 * 向量分布和原始片段差得远；这里只做了换序 + 换壳，所以 ⑥ 的支撑度天然偏高，
	 * θa 的绝对值在这个台子上标不准。能读的是**相对差值**（开/关某道闸），
	 * 不是绝对阈值。设了 OPENAI_API_KEY 时可以换成真生成，这里不做。
	 */
	function compose(chunks) {
		if (chunks.length === 0) return "（本课程下没有可用资料）";
		const top = chunks[0].doc;
		const sentences = top.text.split(/(?<=。)/).filter(Boolean);
		const lead = sentences[0] ?? top.text;
		const rest = sentences.slice(1).join("");
		const also = chunks[1] ? `另外可以对照《${chunks[1].doc.title}》一起看。` : "";
		return `简单说：${lead}${rest ? `\n\n展开一点：${rest}` : ""}${also ? `\n\n${also}` : ""}\n\n（依据：《${top.title}》v${top.version}）`;
	}

	async function generate(req, cfg, chunks) {
		const hits = chunks ?? (await retrieve(cfg.preAnonRetrieval ? req.text : req.anonText, cfg, req.unit));
		const answer = compose(hits);
		// ⑥ 要拿这个向量跟检索片段比，必须落在**同一个向量空间**里 ——
		// 用句对模型编码答案、用检索模型编码片段，算出来的余弦没有意义。
		const [ansVec] = await encoder.embedPassage([answer]);
		seq += 1;
		cache.push({
			id: seq,
			scope: scopeKey(cfg, req),
			unit: req.unit ?? null,
			user: req.user,
			promptAnon: req.anonText,
			promptHash: normalize(req.anonText),
			promptVec: req.qVec,
			answer,
			answerVec: ansVec,
			sourceIds: hits.map(h => h.doc.id),
			corpusVersion: fingerprint(hits.map(h => h.doc.id)),
			createdBy: req.user,
		});
		counters.regen += 1;
		lastSources = hits.map(h => h.doc.id);
		return answer;
	}

	function evict(entry) {
		cache = cache.filter(e => e.id !== entry.id);
		counters.evict += 1;
	}

	async function ask(input, cfg) {
		const config = { ...DEFAULTS, ...cfg };
		counters.ask += 1;
		const trace = [];
		const anon = anonymize(input.text);
		const req = {
			...input,
			anonText: anon.text,
			piiFound: anon.found.length > 0,
		};

		/* ① 门控 ------------------------------------------------------ */
		const scope = scopeKey(config, req);
		trace.push({
			gate: 1,
			name: "Presidio 门控 · 定 scope",
			verdict: config.gate1 ? "pass" : "off",
			detail: config.gate1
				? `检出 ${anon.found.length} 个实体 → scope = ${scope}`
				: `门控关闭 → scope = ${scope}（跨学生共享）`,
			extra: anon.found.length ? `匿名化后：${req.anonText}` : null,
		});

		/* ② L0 精确匹配 ----------------------------------------------- */
		const exact = cache.find(e => e.scope === scope && e.promptHash === normalize(req.anonText));
		if (exact) {
			// 注意：塌陷发生在这里也一样 —— key 建在匿名化后的文本上。
			// 所以 ② 命中也要过 ⑤⑥，不能直接返回。
			trace.push({
				gate: 2,
				name: "L0 精确匹配",
				verdict: "hit",
				detail: `命中条目 #${exact.id}（由 ${exact.createdBy} 写入）— 匿名化后逐字相同`,
			});
			counters.exact += 1;
			return finish(exact, req, config, trace, 1);
		}
		trace.push({ gate: 2, name: "L0 精确匹配", verdict: "miss", detail: "无逐字相同的条目" });

		/* ③ 向量召回 top-K -------------------------------------------- */
		const [qVec] = await encoder.embed([req.anonText]);
		req.qVec = qVec;
		const pool = cache.filter(e => e.scope === scope);
		const cands = pool
			.map(e => ({ entry: e, cos: cosine(qVec, e.promptVec) }))
			.sort((a, b) => b.cos - a.cos)
			.slice(0, config.topK);

		if (cands.length === 0 || cands[0].cos < config.recallFloor) {
			trace.push({
				gate: 3,
				name: `向量召回 top-${config.topK}`,
				verdict: "exit",
				detail:
					cands.length === 0
						? "该 scope 下缓存为空"
						: `最高余弦 ${cands[0].cos.toFixed(3)} < 召回下限 ${config.recallFloor}`,
			});
			return { answer: await generate(req, config), trace, decision: "regenerate", exitedAt: 3, sourceIds: lastSources };
		}
		trace.push({
			gate: 3,
			name: `向量召回 top-${config.topK}`,
			verdict: "pass",
			detail: `${cands.length} 条候选，最高余弦 ${cands[0].cos.toFixed(3)}`,
			extra: cands.map(c => `#${c.entry.id} ${c.cos.toFixed(3)} ${c.entry.promptAnon}`).join("　|　"),
		});

		/* ④ cross-encoder 重排 ---------------------------------------- */
		let best = cands[0];
		let qScore = cands[0].cos;
		if (config.gate4 && encoder.rerankAvailable) {
			const scored = [];
			for (const c of cands) {
				scored.push({ ...c, ce: await encoder.rerank(req.anonText, c.entry.promptAnon) });
			}
			scored.sort((a, b) => b.ce - a.ce);
			best = scored[0];
			qScore = scored[0].ce;
			if (qScore < config.thetaQ) {
				trace.push({
					gate: 4,
					name: "Cross-encoder 重排",
					verdict: "exit",
					detail: `重排分 ${qScore.toFixed(3)} < θq ${config.thetaQ}`,
					extra: scored.map(s => `#${s.entry.id} ce=${s.ce.toFixed(3)} (cos=${s.cos.toFixed(3)})`).join("　|　"),
				});
				return { answer: await generate(req, config), trace, decision: "regenerate", exitedAt: 4, sourceIds: lastSources };
			}
			trace.push({
				gate: 4,
				name: "Cross-encoder 重排",
				verdict: "pass",
				detail: `重排分 ${qScore.toFixed(3)} ≥ θq ${config.thetaQ}`,
				extra: scored.map(s => `#${s.entry.id} ce=${s.ce.toFixed(3)} (cos=${s.cos.toFixed(3)})`).join("　|　"),
			});
		} else {
			const why = !config.gate4 ? "已关闭" : "无可用重排器";
			if (qScore < config.thetaQ) {
				trace.push({
					gate: 4,
					name: "Cross-encoder 重排",
					verdict: "exit",
					detail: `${why} — 退化为纯余弦判据：${qScore.toFixed(3)} < θq ${config.thetaQ}`,
				});
				return { answer: await generate(req, config), trace, decision: "regenerate", exitedAt: 4, sourceIds: lastSources };
			}
			trace.push({
				gate: 4,
				name: "Cross-encoder 重排",
				verdict: "off",
				detail: `${why} — 退化为纯余弦判据：${qScore.toFixed(3)} ≥ θq ${config.thetaQ}，放行`,
			});
		}

		return finish(best.entry, req, config, trace, null);
	}

	/** ⑤ ⑥ 与置信带分档。exact 命中也要走这里。 */
	async function finish(entry, req, config, trace, _from) {
		/* ⑤ 语料版本 —— 无论开关都算，好让 UI 看见"关掉会怎样" */
		const now = fingerprint(entry.sourceIds);
		const stale = entry.corpusVersion !== now;
		if (stale && config.gate5) {
			trace.push({
				gate: 5,
				name: "语料版本比对",
				verdict: "exit",
				detail: `版本不符 → evict 条目 #${entry.id}`,
				extra: `缓存写入时 ${entry.corpusVersion}　→　当前 ${now}`,
			});
			evict(entry);
			return { answer: await generate(req, config), trace, decision: "regenerate", exitedAt: 5, sourceIds: lastSources };
		}
		trace.push({
			gate: 5,
			name: "语料版本比对",
			verdict: stale ? "would-exit" : config.gate5 ? "pass" : "off",
			detail: stale ? "版本不符，但 ⑤ 已关闭 —— 这一条会带着过期答案放行" : "版本一致",
			extra: stale ? `缓存写入时 ${entry.corpusVersion}　→　当前 ${now}` : null,
		});

		/* ⑥ 回答侧校验 */
		const retrievalText = config.preAnonRetrieval ? req.text : req.anonText;
		const chunks = await retrieve(retrievalText, config, req.unit);
		// 取 max 而不是重心：「被支撑」是「有某一个片段支撑得住」，
		// 对一堆片段求平均会把信号糊掉。
		const support = chunks.length ? Math.max(...chunks.map(c => cosine(entry.answerVec, c.vec))) : 0;
		const wouldExit = support < config.thetaALo;

		if (config.gate6 && wouldExit) {
			trace.push({
				gate: 6,
				name: "回答侧校验",
				verdict: "exit",
				detail: `支撑度 ${support.toFixed(3)} < θa低 ${config.thetaALo} → evict 条目 #${entry.id}`,
				extra: `检索用的是${config.preAnonRetrieval ? "保留实体的原文" : "匿名化后的文本"}：${retrievalText}　→　命中 ${chunks.map(c => c.doc.title).join("、")}`,
			});
			evict(entry);
			return { answer: await generate(req, config, chunks), trace, decision: "regenerate", exitedAt: 6, sourceIds: lastSources };
		}

		trace.push({
			gate: 6,
			name: "回答侧校验",
			verdict: !config.gate6 ? "off" : wouldExit ? "would-exit" : "pass",
			detail: !config.gate6
				? `已关闭（支撑度本会是 ${support.toFixed(3)}${wouldExit ? "，本该拦下" : ""}）`
				: `支撑度 ${support.toFixed(3)}`,
			extra: `检索用的是${config.preAnonRetrieval ? "保留实体的原文" : "匿名化后的文本"}：${retrievalText}　→　命中 ${chunks.map(c => c.doc.title).join("、")}`,
		});

		/* 置信带分档 */
		if (support >= config.thetaAHi || !config.gate6) {
			counters.reuse += 1;
			return { answer: entry.answer, trace, decision: "reuse", entryId: entry.id, exitedAt: null, sourceIds: entry.sourceIds };
		}
		counters.tune += 1;
		return {
			answer: `${entry.answer}\n（已按本次检索到的《${chunks[0]?.doc.title ?? "—"}》微调）`,
			trace,
			decision: "tune",
			entryId: entry.id,
			exitedAt: null,
			sourceIds: entry.sourceIds,
		};
	}

	return {
		ask,
		get docs() {
			return docs;
		},
		get cache() {
			return cache;
		},
		get counters() {
			return counters;
		},
		bumpCorpus() {
			docs = docs.map(d => (d.id === "syl" ? { ...d, version: 2, text: SYL_V2 } : d));
			return fingerprint(["syl"]);
		},

		/**
		 * 用干扰问题预热缓存。
		 *
		 * 不做这一步的话，跑用例时缓存里只有播种的那 1 条，「top-5 召回」实际只召回
		 * 1 条 —— ④ 重排根本没有东西可排，测出来的差值没有意义。
		 */
		async warm(cfg) {
			for (const t of DISTRACTORS) await ask({ text: t, user: "warm" }, cfg);
			return cache.length;
		},
		reset() {
			docs = DOCS.map(d => ({ ...d }));
			cache = [];
			seq = 0;
			counters = fresh();
		},
		/** 跑完整场景集，返回每条的实际判定与是否符合标注。 */
		async bench(cfg) {
			const rows = [];
			for (const s of SCENARIOS) {
				this.reset();
				await this.warm(cfg); // 先灌干扰缓存，让 ③ 的 top-5 真的有东西可排
				await ask({ ...s.seed }, cfg);
				if (s.bumpCorpus) this.bumpCorpus();
				const r = await ask({ ...s.probe }, cfg);
				const got = r.decision === "reuse" || r.decision === "tune" ? "reuse" : "regenerate";
				// 判据是「答案基于哪篇资料」，不是「有没有复用」——命中另一条内容
				// 正确的缓存也是成功。
				const basedOn = r.sourceIds ?? [];
				// 答案是用 chunks[0] 拼的，所以判据必须是**首要依据**。
				// 先前判的是「期望文档出现在依据里」——太松：复用了过拟合的答案、
				// 但欠拟合那篇碰巧也在 top-3 里，就被判成通过了。
				const ok = basedOn[0] === s.expectDoc;
				rows.push({
					key: s.key,
					label: s.label,
					note: s.note,
					expect: s.expect,
					expectDoc: s.expectDoc,
					basedOn,
					got,
					ok,
					exitedAt: r.exitedAt,
					expectedGate: s.catches == null ? null : [].concat(s.catches).join("/"),
					rightGate: s.catches == null ? null : [].concat(s.catches).includes(r.exitedAt),
					answer: r.answer,
				});
			}
			this.reset();
			// 假命中 = 复用了缓存，但答案基于错误的资料（学生拿到错答案）
			const falseHit = rows.filter(r => !r.ok && r.got === "reuse").length;
			// 白跑 = 重新生成了，但生成的答案依据仍然不对（检索本身的问题，不是缓存的锅）
			const missed = rows.filter(r => !r.ok && r.got === "regenerate").length;
			return { rows, falseHit, missed, total: rows.length };
		},
	};
}
